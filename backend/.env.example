# Copy this file to `.env` (gitignored) for local development.
# In production, export these variables in the environment instead (e.g. Docker `environment:`).
# Never commit the real `.env`.

# Persistent login state (JSON file)
IDENTITY_PATH=./identity.json

# Gameforge account credentials
GF_EMAIL=you@example.com
GF_PASSWORD=your_password
INSTALLATION_ID=00000000-0000-0000-0000-000000000000

# Nostale login server
LOGIN_SERVER_IP=127.0.0.1
LOGIN_SERVER_PORT=4000

# Max game clients to spawn (optional, default 5)
MAX_CLIENTS=5

# Optional: force development mode (loads and exports .env into the process).
# Default is off for Release builds and on for Debug builds.
NOSBAZAR_DEV=1